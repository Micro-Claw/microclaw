  "operations": [
    {
      "name": "self_check",
      "input_schema": {
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      }
    },
    {
      "name": "observe_dataset",
      "input_schema": {
        "type": "object"
      },
      "output_schema": {
        "type": "object"
      },
      "metrics": {
        "mean_intensity": {
          "description": "Mean pixel value of each frame, from up to 1,024 evenly spaced sampled pixels",
          "unit": "ADU",
          "kind": "per_frame"
        },
        "peak_intensity": {
          "description": "Maximum pixel value of each frame, from the same up to 1,024 sampled pixels",
          "unit": "ADU",
          "kind": "per_frame"
        },
        "frames_read": {
          "description": "Number of dataset frames read so far",
          "unit": "frames",
          "kind": "counter"
        },
        "frame_bytes": {
          "description": "Pixel bytes in the most recently read frame",
          "unit": "bytes",
          "kind": "gauge"
        }
      }
    }
  ],
