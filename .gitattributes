# Batch files are parsed line by line by cmd.exe; a label or `goto` read with a
# bare LF can be mis-parsed. Force CRLF in the working tree on every platform,
# so a checkout on Windows always yields a runnable install.bat.
*.bat text eol=crlf
*.cmd text eol=crlf

# The icon and derived PNG are binary; never touch their bytes.
*.ico binary
*.png binary

# Retained M5 evidence must survive checkout byte-for-byte on every platform.
tests/fixtures/hooks/m5_legacy/*.py binary

# A release's assets are pinned by SHA-256 in its manifest, so the fixture's
# bytes must survive checkout byte-for-byte: a CRLF translation on Windows
# changes the digest and the package stops validating. `-text` rather than
# `binary`, so these stay reviewable in a diff.
tests/fixtures/skill_packages/** -text
