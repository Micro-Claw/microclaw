# Python
__pycache__/
*.py[cod]
*.pyo

# Distribution / build
dist/
build/
*.egg-info/
*.egg
MANIFEST

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# uv's resolved lockfile. Deliberately untracked: the rigs install with
# `pip install -e .` (CLAUDE.md §"Debugging checklist"), not `uv sync`, so a
# committed lock would be pinned by nobody and drift silently. It appeared as an
# untracked file in two Block 4g gate bundles and muddied the clean-tree
# precondition, which is what prompted this. Reverse it if the rigs ever move to
# `uv sync` — for an application uv's own advice is to commit it.
uv.lock

# Virtual environments
.venv/
venv/
env/
.env

# Conda environments (if stored in-repo)
envs/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store
._*

# Editors
.idea/
.vscode/

# data — scope to microclaw's own outputs, not every *.json (which would hide
# test fixtures and config files).
*_microclaw_history.json
.microclaw/

# Spike scratch. Spikes are committed as source; what they WRITE never is —
# tiles, probability maps, .ilp projects and captured stdout are outputs, and a
# finding belongs in the design doc, not in a 6 MB directory nobody rereads.
d26_tiles/
design-*-out.txt

# Local editor/agent settings
.claude/settings.local.json
# Per-rig safety limits. `microclaw init` writes these to a per-user directory,
# but a copy in the working tree is common — never commit a lab machine's real
# limits as if they were repo defaults (design/14 §6). The committed example
# lives at microclaw/safety_config.example.yaml.
safety_config.yaml

# Rig-gate probe output and stray transcripts land in the repo root.
# Spike OUTPUTS are never committed (only the spike .py under design/).
/*.txt

# Rig/demo gate evidence lives outside the repo (design/26-29-32-33 checklist:
# commit the spike and the findings, never the output artifacts).
microclaw_block7/
# Gate runbooks build their evidence directory in the working tree before it is
# copied out to ~/Documents/.../Micro-Claw. Ignored so a rig's own evidence can
# never be committed as source, and so `git status --short` stays empty for the
# clean-tree precondition those same runbooks assert.
block*-20*/

# Retained rig histories staged at the repo root for comparison (evidence, not source).
/*_microclaw_history_*.json
